{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "tsBuildInfoFile": "./dist/tsconfig.build.tsbuildinfo",
    "declaration": true,
    "removeComments": true
  },
  "exclude": [
    "node_modules",
    "test",
    "src/test/**/*",
    "dist",
    "**/*spec.ts",
    "scripts/**/*",
    "prisma/**/*"
  ],
  "include": ["src/**/*.ts"]
}
