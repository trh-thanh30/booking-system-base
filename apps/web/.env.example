# =========================================================================
# WEB / LANDING + BUSINESS ADMIN
# =========================================================================
# Copy into apps/web/.env.local only when this app needs app-local overrides.
# Root .env.development is still the default for monorepo scripts.

WEB_PORT=3001
NEXT_PUBLIC_WEB_URL="http://localhost:3001"
NEXT_PUBLIC_API_URL="http://localhost:3000/api/v1"
NEXT_PUBLIC_ASSET_URL="http://localhost:3000/uploads/public/"
NEXT_PUBLIC_AUTH_CONTEXT=client

# Business address onboarding uses Leaflet with OpenStreetMap tiles.
# No API key required. Keep attribution visible; do not bulk-download/prefetch.
# See https://operations.osmfoundation.org/policies/tiles/
# Use an OSM-compatible tile provider for production traffic if required.
NEXT_PUBLIC_MAP_TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
