# =========================================================================
# GLOBAL ENVIRONMENT SETTINGS
# =========================================================================
NODE_ENV=development
TZ=Asia/Ho_Chi_Minh
COMPOSE_PROJECT_NAME=booking-base


# =========================================================================
# BACKEND (API) CONFIGURATION
# =========================================================================
APP_NAME="Booking System API"
APP_VERSION="1.0.0"
API_PORT=3000
PORT=${API_PORT}
BE_PORT=${API_PORT}
BACKEND_URL="http://localhost:3000"
PUBLIC_API_URL="http://localhost:3000/api/v1"

# Security & Auth
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key_here
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=24h
BCRYPT_ROUNDS=12

# Storage & Uploads
STORAGE_DRIVER=local
UPLOAD_DEST=./uploads
MAX_FILE_SIZE=10485760
STORAGE_ROOT_DIR=./storage
STORAGE_PUBLIC_DIR_NAME=public
STORAGE_PRIVATE_DIR_NAME=private
STORAGE_TEMP_DIR_NAME=temp
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_PUBLIC=booking-public
MINIO_BUCKET_PRIVATE=booking-private
MINIO_BUCKET_TEMP=booking-temp
MINIO_CONSOLE_PORT=9001
# local: URL exposed by the API ServeStaticModule.
ASSET_CDN_URL="http://localhost:3000/cdn"
# minio example: http://localhost:9000/booking-public
ASSET_MAX_FILE_SIZE=10485760
ASSET_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,image/webp,image/svg+xml,video/mp4,video/quicktime,audio/mpeg,audio/wav,application/pdf

# =========================================================================
# FRONTEND (LANDING + BUSINESS ADMIN) CONFIGURATION
# =========================================================================
WEB_PORT=3001
WEB_URL="http://localhost:3001"
NEXT_PUBLIC_WEB_URL="http://localhost:3001"
# Canonical base origin for Tenant-branded Business Admin URLs.
# Development stays on localhost; staging/production add the Tenant slug.
# Production example: base https://app.bookingbase.com becomes
# https://{tenantSlug}.app.bookingbase.com.
ADMIN_WORKSPACE_URL="http://localhost:3001"
NEXT_PUBLIC_ADMIN_WORKSPACE_URL="http://localhost:3001"
NEXT_PUBLIC_API_URL="http://localhost:3000/api/v1"
NEXT_PUBLIC_BOOKING_DOMAIN="localhost:3001"

# =========================================================================
# BUSINESS ADMIN shares WEB_PORT and the Web origin under /{locale}/admin/*.
# No ADMIN_URL path prefix: backend OAuth redirects use WEB_URL / NEXT_PUBLIC_WEB_URL.
# ADMIN_WORKSPACE_URL is a base origin only; code prefixes the authenticated Tenant slug.

# =========================================================================
# FRONTEND (PLATFORM ADMIN PORTAL) CONFIGURATION
# =========================================================================
PLATFORM_ADMIN_PORT=3003
PLATFORM_ADMIN_URL="http://localhost:3003"
NEXT_PUBLIC_PLATFORM_ADMIN_URL="http://localhost:3003"

# =========================================================================
# DOCKER IMAGES
# =========================================================================
API_IMAGE=booking-api
WEB_IMAGE=booking-web
PLATFORM_ADMIN_IMAGE=booking-platform-admin
IMAGE_TAG=latest

# =========================================================================
# DATABASE (POSTGRESQL) CONFIGURATION
# =========================================================================
DB_HOST=localhost
DB_PORT=15432
DB_USER=booking_base_user
DB_PASSWORD=booking_base_password
DB_NAME=booking_base
DB_SCHEMA=public

# Standardized DATABASE_URL
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=${DB_SCHEMA}

# Docker Database Config (Keep in sync with variables above)
POSTGRES_USER=booking_base_user
POSTGRES_PASSWORD=booking_base_password
POSTGRES_DB=booking_base
DEV_DB_PORT=15432
PROD_DB_PORT=25432

# =========================================================================
# CACHE (REDIS) CONFIGURATION
# =========================================================================
REDIS_HOST=localhost
REDIS_DEV_PORT=16379
REDIS_PASSWORD=booking_base_redis_password
REDIS_DB_PORT=16379

# Standardized REDIS_URL
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_DEV_PORT}

# =========================================================================
# EMAIL (SMTP) CONFIGURATION
# =========================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="${APP_NAME} Agent <no-reply@example.com>"
EMAIL_FROM="${APP_NAME} <${SMTP_USER}>"
EMAIL_TEMPLATES_PATH=src/modules/email/templates

# =========================================================================
# THIRD-PARTY SERVICES & OAUTH
# =========================================================================

# Google OAuth
# Current Google Cloud UI (select the correct project first):
# 1. Open https://console.cloud.google.com/auth/overview
#    If Google Auth Platform is not configured, click Get started.
# 2. Complete the setup wizard:
#    App Information -> enter App name and User support email -> Next.
#    Audience -> select External -> Next.
#    Contact Information -> enter Developer contact email -> Next.
#    Finish -> accept the Google API Services User Data Policy -> Create.
# 3. Open https://console.cloud.google.com/auth/audience
#    While Publishing status is Testing, go to Test users -> Add users,
#    add every Google account allowed to test the login, then click Save.
# 4. Open https://console.cloud.google.com/auth/clients -> Create client.
#    Application type: Web application. Enter a recognizable client name.
# 5. In Authorized redirect URIs click Add URI and enter exactly:
#    http://localhost:3000/api/v1/auth/admin/google/callback
#    Add a separate HTTPS API callback URI for staging and production.
#    Authorized JavaScript origins are not required by this backend redirect flow.
# 6. Click Create, then immediately copy/download the Client ID and Client
#    secret. Google may only show the full new secret once. Never commit it.
# 7. If the Google Auth Platform menu is unavailable in an older console UI:
#    APIs & Services -> OAuth consent screen configures Branding/Audience;
#    APIs & Services -> Credentials -> Create credentials -> OAuth client ID
#    creates the Web application client.
# 8. GOOGLE_REDIRECT_URI must exactly match an Authorized redirect URI,
#    including protocol, host, port, path, case and trailing slash.
# GOOGLE_OAUTH_STATE_TTL_SECONDS is the one-time OAuth state lifetime in seconds;
# keep the default 600 unless the authentication flow has a specific requirement.
# GOOGLE_ONBOARDING_TTL_SECONDS controls how long a verified first-time Google
# profile can finish Business onboarding; keep the default 900 seconds.
GOOGLE_CLIENT_ID="GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="GOOGLE_CLIENT_SECRET"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/v1/auth/admin/google/callback"
GOOGLE_OAUTH_STATE_TTL_SECONDS=600
GOOGLE_ONBOARDING_TTL_SECONDS=900

# =========================================================================
# MONITORING & LOGGING
# =========================================================================
LOG_LEVEL=info
LOG_FILE_MAX_SIZE=10m
LOG_FILE_MAX_FILES=5
PROMETHEUS_ENABLED=false
METRICS_PORT=19090
HEALTH_ENDPOINTS_ENABLED=false

# =========================================================================
# TELEGRAM NOTIFICATIONS - CI/CD
# =========================================================================
CI_TELEGRAM_BOT_TOKEN=
CI_TELEGRAM_CHAT_ID=

# =========================================================================
# PRODUCTION BACKUPS
# =========================================================================
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=7
BACKUP_TELEGRAM_ENABLED=true

# =========================================================================
# GRAFANA CONFIGURATION
# =========================================================================
GRAFANA_PORT=4103
GRAFANA_ADMIN_USER=booking_admin
GRAFANA_ADMIN_PASSWORD=booking_grafana_change_me
GRAFANA_LOG_LEVEL=info

# =========================================================================
# NETWORK & CORS
# =========================================================================
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3003,http://localhost:4100,http://localhost:4101,http://localhost:4103"
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# =========================================================================
# COOKIE
# =========================================================================
# Development uses localhost for Web, API and Google OAuth.
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_PARTITIONED=false
COOKIE_MAX_AGE=604800000
COOKIE_PATH=/
COOKIE_AUTH_PATH_PREFIX=/api/v1/auth
# Staging/production recommendation when Admin and API share one site:
# COOKIE_DOMAIN=
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=lax
